# servercore backend — production env for docker compose and systemd.
#
# every key below exists in backend/src/config/env.ts; defaults in this file
# match the schema. keep the format simple: one KEY=value per line, comments
# on their own line. docker compose and systemd both take a '#' inside a value
# literally, so no trailing comments after a value.
#
# copy to ./backend.env (compose) or /etc/servercore/backend.env (systemd)
# and fill in the values marked CHANGE_ME. never commit the copy.

# development | production | test — use production for a real install
NODE_ENV=production

# fastify http plane: GET /health only. the plugin never talks to it.
PORT=8080
# bind address shared by the http plane and the websocket gateway
HOST=0.0.0.0

# plugin websocket gateway, a separate listener on its own port.
# the plugin url is <scheme>://<host>:<ws port>/ws — this port must match
# the proxy upstream and the plugin's backend.url
WS_PORT=8081

# the database: accounts, votes, audit, events. use mongodb+srv:// for atlas
# or a replica set connection string on a production host
MONGODB_URI=mongodb://127.0.0.1:27017/servercore

# telegram bot. empty = the backend runs bot-less: no admission, no account
# flows, log line 'bot is disabled'
BOT_TOKEN=

# closed community group: voting runs here and approved members are invited.
# numeric id, e.g. -1001234567890. empty degrades the group flow gracefully
GROUP_CHAT_ID=
# group chat id used for kick/invite management (string form)
TELEGRAM_GROUP_CHAT_ID=

# questionnaire, json arrays. ru and en must have the same length, 1..10 items
APPLICATION_QUESTIONS_RU=["Как давно играешь в Minecraft?","Почему хочешь присоединиться?","Как часто планируешь играть?","Есть ли опыт игры на подобных серверах?"]
APPLICATION_QUESTIONS_EN=["How long have you been playing Minecraft?","Why do you want to join?","How often do you plan to play?","Do you have experience on similar servers?"]

# voting window in minutes (the product value is 180 = 3 hours) and how often
# the scheduler sweeps for expired votings
VOTING_DURATION_MINUTES=180
VOTING_SCAN_INTERVAL_MS=60000

# lifetime of the one-time group invite, hours
GROUP_INVITE_TTL_HOURS=48

# vote button icons (bot api 9.4 custom emoji). needs telegram premium on the
# bot owner — leave off unless you confirmed it works for your bot
VOTE_BUTTON_ICONS_ENABLED=false
VOTE_BUTTON_ICON_ACCEPT_ID=
VOTE_BUTTON_ICON_REJECT_ID=

# message effect on the approval celebration message (bot api 7.4)
APPROVAL_MESSAGE_EFFECT_ID=5104841245759776310

# application starts per telegram account per window
APPLICATION_START_LIMIT=3
APPLICATION_START_WINDOW_MS=60000

# trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# per-game-server secrets as one line of json: {"<server id>": "<secret>"}.
# the key is the plugin's backend.server-id, the secret is its backend.secret.
# this pair is the only trust anchor between backend and plugin.
# the placeholder below is deliberately too short: the backend refuses to boot
# until every secret is at least 32 characters (openssl rand -hex 32)
SERVERCORE_SERVER_CREDENTIALS={"game-1":"CHANGE_ME_32_CHARS_MINIMUM"}

# websocket tuning. WS_MAX_PACKET_BYTES is capped at 1 MiB by the schema
WS_HEARTBEAT_INTERVAL_MS=15000
WS_HEARTBEAT_TIMEOUT_MS=10000
WS_MAX_PACKET_BYTES=262144
# handshake timestamp window: both hosts must be within this of each other (ntp)
WS_REPLAY_WINDOW_MS=30000
WS_NONCE_TTL_MS=120000
# graceful shutdown: in-flight handlers get this long before sockets close
WS_DRAIN_TIMEOUT_MS=5000

# one-time login/link request lifetime, seconds (the schema enforces 60..90)
AUTH_REQUEST_TTL_SECONDS=75

# retention: audit/server_events lifetime and closed-session lifetime in days,
# first cleanup pass after boot in minutes (then daily)
RETENTION_AUDIT_DAYS=90
RETENTION_SESSION_DAYS=60
RETENTION_INITIAL_DELAY_MINUTES=5

# server name shown in telegram auth prompts
SERVER_NAME=ServerCore

# sliding-window rate limits for the auth flow
AUTH_RATE_LIMIT_WINDOW_SECONDS=300
AUTH_RATE_LIMIT_REQUESTS_PER_PLAYER=5
AUTH_RATE_LIMIT_REQUESTS_PER_TELEGRAM=10
AUTH_RATE_LIMIT_APPROVALS_PER_TELEGRAM=30

# optional telegram message effect for the auth prompt. empty = none
AUTH_MESSAGE_EFFECT_ID=

# how often pending auth requests are swept for expiry and delivery retries
AUTH_SWEEP_INTERVAL_MS=1000

# ops: telegram ids that receive event copies and may use /stats (comma separated)
ADMIN_TELEGRAM_IDS=

# language of the bot's own messages and ops notifications: ru | en
OPS_LOCALE=ru

# no websocket frame for this long => the game server is presumed offline and
# admins get a crash alert
SERVER_OFFLINE_ALERT_MINUTES=5
# send that crash alert to every linked user as well, not only admins
NOTIFY_USERS_ON_OFFLINE=false
# outbound telegram ceiling, messages per second (telegram allows ~30/s)
NOTIFICATION_RATE_PER_SECOND=30

# custom emoji in bot messages (bot api 9.4, needs telegram premium on the owner)
BOT_CUSTOM_EMOJI=false

# timezone for log timestamps and schedules. must be a valid IANA zone
LOG_TIMEZONE=Europe/Moscow
