# servercore backend config
# copy to .env and fill in real values. .env is never committed.

NODE_ENV=development

# http + health endpoints (fastify)
PORT=8080
HOST=0.0.0.0

# plugin websocket gateway (native bun.serve)
WS_PORT=8081

# mongodb
MONGODB_URI=mongodb://localhost:27017/servercore

# telegram bot (leave empty to run without the bot)
BOT_TOKEN=
TELEGRAM_BOT_USERNAME=ServerCoreBot

# logging: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# per-game-server secrets as json: {"<serverId>": "<secret>"}
# secrets must be at least 32 chars, generate with: openssl rand -hex 32
SERVERCORE_SERVER_CREDENTIALS={"game-1":"replace-with-long-random-secret"}

# websocket tuning
WS_HEARTBEAT_INTERVAL_MS=15000
WS_HEARTBEAT_TIMEOUT_MS=10000
WS_MAX_PACKET_BYTES=262144
WS_REPLAY_WINDOW_MS=30000
WS_NONCE_TTL_MS=120000

# one-time auth request lifetime, seconds (60-90)
AUTH_REQUEST_TTL_SECONDS=75

# ops: telegram admin ids (comma separated) - event copies + /stats access
ADMIN_TELEGRAM_IDS=

# locale for ops notifications: ru | en
OPS_LOCALE=ru

# ws silent for this long => server presumed offline (crash alert to admins)
SERVER_OFFLINE_ALERT_MINUTES=5

# crash alert also dm-ed to all linked users, not just admins
NOTIFY_USERS_ON_OFFLINE=false

# outbound broadcast rate ceiling, messages per second (telegram cap ~30)
NOTIFICATION_RATE_PER_SECOND=30

# pretty server name shown in telegram auth prompts
SERVER_NAME=ServerCore

# sliding window rate limits for the auth flow (seconds / counts)
AUTH_RATE_LIMIT_WINDOW_SECONDS=300
AUTH_RATE_LIMIT_REQUESTS_PER_PLAYER=5
AUTH_RATE_LIMIT_REQUESTS_PER_TELEGRAM=10
AUTH_RATE_LIMIT_APPROVALS_PER_TELEGRAM=30

# optional telegram message effect for the auth prompt (leave empty = none)
AUTH_MESSAGE_EFFECT_ID=

# auth sweep cadence: expiry enforcement + undelivered prompt retries (ms)
AUTH_SWEEP_INTERVAL_MS=1000
