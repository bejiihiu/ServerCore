# servercore backend config
# copy to .env and fill in real values. .env is never committed.

NODE_ENV=development

# http + health endpoints (fastify)
PORT=8080
HOST=0.0.0.0

# plugin websocket gateway (native bun.serve)
WS_PORT=8081

# mongodb
MONGODB_URI=mongodb://localhost:27017/servercore

# telegram bot (leave empty to run without the bot)
BOT_TOKEN=

# closed telegram group (voting + member management). leave empty until the
# group exists — the group flow degrades gracefully
GROUP_CHAT_ID=

# questionnaire questions as json arrays, ru and en must have equal length
APPLICATION_QUESTIONS_RU=["Как давно играешь в Minecraft?","Почему хочешь присоединиться?","Как часто планируешь играть?","Есть ли опыт игры на подобных серверах?"]
APPLICATION_QUESTIONS_EN=["How long have you been playing Minecraft?","Why do you want to join?","How often do you plan to play?","Do you have experience on similar servers?"]

# voting window (the spec value is 3 hours) and scheduler sweep interval
VOTING_DURATION_MINUTES=180
VOTING_SCAN_INTERVAL_MS=60000

# one-time group invite lifetime, hours
GROUP_INVITE_TTL_HOURS=48

# vote button icons (bot api 9.4 icon_custom_emoji_id). requires telegram
# premium on the bot owner — keep off until confirmed; ids are stable custom
# emoji ids, e.g. from the tgiosicons pack
VOTE_BUTTON_ICONS_ENABLED=false
VOTE_BUTTON_ICON_ACCEPT_ID=
VOTE_BUTTON_ICON_REJECT_ID=

# message effect (bot api 7.4) on the approval celebration message
APPROVAL_MESSAGE_EFFECT_ID=5104841245759776310

# application starts per telegram account per window
APPLICATION_START_LIMIT=3
APPLICATION_START_WINDOW_MS=60000

# logging: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# per-game-server secrets as json: {"<serverId>": "<secret>"}
# secrets must be at least 32 chars, generate with: openssl rand -hex 32
SERVERCORE_SERVER_CREDENTIALS={"game-1":"replace-with-a-32-char-random-secret"}

# websocket tuning
WS_HEARTBEAT_INTERVAL_MS=15000
WS_HEARTBEAT_TIMEOUT_MS=10000
WS_MAX_PACKET_BYTES=262144
WS_REPLAY_WINDOW_MS=30000
WS_NONCE_TTL_MS=120000
# graceful shutdown: in-flight handler waits get this long before sockets close
WS_DRAIN_TIMEOUT_MS=5000

# one-time auth request lifetime, seconds (60-90)
AUTH_REQUEST_TTL_SECONDS=75

# retention (atlas m0 housekeeping): audit/server_events lifetime, closed
# session lifetime (days), first cleanup pass after boot (minutes, then daily)
RETENTION_AUDIT_DAYS=90
RETENTION_SESSION_DAYS=60
RETENTION_INITIAL_DELAY_MINUTES=5

# pretty server name shown in telegram auth prompts
SERVER_NAME=ServerCore

# sliding window rate limits for the auth flow (seconds / counts)
AUTH_RATE_LIMIT_WINDOW_SECONDS=300
AUTH_RATE_LIMIT_REQUESTS_PER_PLAYER=5
AUTH_RATE_LIMIT_REQUESTS_PER_TELEGRAM=10
AUTH_RATE_LIMIT_APPROVALS_PER_TELEGRAM=30

# optional telegram message effect for the auth prompt (leave empty = none)
AUTH_MESSAGE_EFFECT_ID=

# auth sweep cadence: expiry enforcement + undelivered prompt retries (ms)
AUTH_SWEEP_INTERVAL_MS=1000

# ops: telegram admin ids (comma separated) - event copies + /stats access
ADMIN_TELEGRAM_IDS=

# locale for ops notifications: ru | en
OPS_LOCALE=ru

# ws silent for this long => server presumed offline (crash alert to admins)
SERVER_OFFLINE_ALERT_MINUTES=5

# crash alert also dm-ed to all linked users, not just admins
NOTIFY_USERS_ON_OFFLINE=false

# outbound broadcast rate ceiling, messages per second (telegram cap ~30)
NOTIFICATION_RATE_PER_SECOND=30

# custom emoji in bot messages (pack tgiosicons). needs telegram premium on
# the bot owner (bot api 9.4) — off keeps unicode fallbacks everywhere
BOT_CUSTOM_EMOJI=false

# closed telegram group chat id (kick/invites); empty until the group exists
TELEGRAM_GROUP_CHAT_ID=

# timezone for log timestamps (project standard: Europe/Moscow)
LOG_TIMEZONE=Europe/Moscow
