# gradle
.gradle/
build/

# ide
.idea/
*.iml
.vscode/
out/

# run dirs
run/
run-folia/

# a server started from the repo root leaves its own state behind
logs/
plugins/
world*/
eula.txt
server.properties

# project-internal notes and ide notes, never in git
notes/
notes.md
IDEA.md

# secrets and env, never in git
.env
.env.*
!.env.example
backend/.env
# the deploy kit's real env file, created from deploy/backend.env.example
deploy/backend.env

# backend (bun)
backend/node_modules/
backend/dist/

# staged release artifacts (root-level dist/ is written by the release workflow)
/dist/

# os junk
Thumbs.db
.DS_Store

# kotlin compiler session dir
.kotlin/
