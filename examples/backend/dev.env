# servercore backend preset: local development. NOT FOR PRODUCTION.
#
# copy to backend/.env and run `bun run dev`. every value is chosen to make a
# loop of "change code - restart - join - watch the log" fast: short windows,
# short retention, debug logging, a single local mongodb. a public server must
# use examples/backend/production.env instead.
#
# the telegram bot is left disabled (empty BOT_TOKEN) so nothing reaches a real
# group while you experiment. add a throwaway bot token if you need the bot
# flows locally.
#
# one KEY=value per line, comments on their own line: docker compose and
# systemd both take a '#' inside a value literally, and so does this preset.

# development | production | test
NODE_ENV=development

# fastify http plane: GET /health only
PORT=8080
# loopback only: never expose a dev instance on 0.0.0.0
HOST=127.0.0.1

# plugin websocket gateway, a separate listener. the plugin url is
# ws://127.0.0.1:8081/ws
WS_PORT=8081

# local mongodb, own database so it cannot touch a real one
MONGODB_URI=mongodb://127.0.0.1:27017/servercore-dev

# empty = bot-less backend (no admission, no account flows)
BOT_TOKEN=

# no real group while developing
GROUP_CHAT_ID=
TELEGRAM_GROUP_CHAT_ID=

# identical wording in both lists, equal length is enforced by the schema
APPLICATION_QUESTIONS_RU=["Как давно играешь в Minecraft?","Почему хочешь присоединиться?","Как часто планируешь играть?","Есть ли опыт игры на подобных серверах?"]
APPLICATION_QUESTIONS_EN=["How long have you been playing Minecraft?","Why do you want to join?","How often do you plan to play?","Do you have experience on similar servers?"]

# a questionnaire step left unanswered this long closes the flow on the next
# update instead of swallowing it. the draft stays, /application resumes it
APPLY_IDLE_TIMEOUT_MINUTES=5

# 5 minutes instead of 3 hours so a voting round finishes while you wait
VOTING_DURATION_MINUTES=5
# sweep often enough to see an expiry land while the test is running
VOTING_SCAN_INTERVAL_MS=5000

# one hour invites: fine for a dev group, expires quickly if leaked
GROUP_INVITE_TTL_HOURS=1

# custom emoji needs telegram premium on the bot owner; skip locally
VOTE_BUTTON_ICONS_ENABLED=false
VOTE_BUTTON_ICON_ACCEPT_ID=
VOTE_BUTTON_ICON_REJECT_ID=

# confetti on the approval celebration message
APPROVAL_MESSAGE_EFFECT_ID=5104841245759776310

# loose questionnaire throttle: you will restart and re-apply a lot
APPLICATION_START_LIMIT=10
APPLICATION_START_WINDOW_MS=10000

# trace | debug | info | warn | error | fatal
LOG_LEVEL=debug

# dev-only shared secret, exactly the shape production expects but not a
# secret at all. matches the plugin preset's backend.secret so a preset pair
# works together out of the box
SERVERCORE_SERVER_CREDENTIALS={"game-1":"replace-with-openssl-rand-hex-32"}

# tighter liveness tuning: a broken local link shows up in seconds
WS_HEARTBEAT_INTERVAL_MS=5000
WS_HEARTBEAT_TIMEOUT_MS=3000
WS_MAX_PACKET_BYTES=262144
WS_REPLAY_WINDOW_MS=30000
WS_NONCE_TTL_MS=30000
WS_DRAIN_TIMEOUT_MS=1000

# shortest lifetime the schema allows (the real band is 60-90 seconds)
AUTH_REQUEST_TTL_SECONDS=60
# sweep twice as fast as production to watch expiry and retries happen
AUTH_SWEEP_INTERVAL_MS=500

# generous auth throttles so repeated test logins are never rate limited
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_REQUESTS_PER_PLAYER=20
AUTH_RATE_LIMIT_REQUESTS_PER_TELEGRAM=20
AUTH_RATE_LIMIT_APPROVALS_PER_TELEGRAM=50

# no effect on the auth prompt locally
AUTH_MESSAGE_EFFECT_ID=

# nobody gets event copies on a dev box
ADMIN_TELEGRAM_IDS=

# ru | en
OPS_LOCALE=en

# one silent minute is already suspicious for a local link
SERVER_OFFLINE_ALERT_MINUTES=1
NOTIFY_USERS_ON_OFFLINE=true
# small ceiling: a dev bot token has no business blasting 30 msg/s
NOTIFICATION_RATE_PER_SECOND=5

# needs telegram premium, off in dev
BOT_CUSTOM_EMOJI=false

# 7 days is the schema minimum: a dev database stays small
RETENTION_AUDIT_DAYS=7
RETENTION_SESSION_DAYS=7
RETENTION_INITIAL_DELAY_MINUTES=1

# name shown in telegram auth prompts
SERVER_NAME=ServerCore Dev

# any valid IANA zone; UTC keeps dev timestamps comparable across machines
LOG_TIMEZONE=UTC
