# servercore backend preset: production.
#
# copy to backend/.env (compose), /etc/servercore/backend.env (systemd) or the
# platform's environment store, then replace every value marked CHANGE_ME.
# every key below exists in backend/src/config/env.ts and the defaults match
# the schema; the values that differ from a plain default install are the ones
# the product is built around (3-hour voting window, 90/60 day retention,
# Europe/Moscow schedules and logs).
#
# one KEY=value per line, comments on their own line: docker compose and
# systemd both take a '#' inside a value literally, so no trailing comments.

# development | production | test
NODE_ENV=production

# fastify http plane: GET /health only. the plugin never talks to it
PORT=8080
# bind address shared by the http plane and the websocket gateway. keep the
# listeners behind a tls-terminating proxy
HOST=0.0.0.0

# plugin websocket gateway. the plugin url is <scheme>://<host>:8081/ws and
# this port must match the proxy upstream
WS_PORT=8081

# accounts, votes, audit, events. CHANGE_ME: point at the real cluster; use
# mongodb+srv:// for atlas or a replica set connection string on own hardware
MONGODB_URI=mongodb://127.0.0.1:27017/servercore

# CHANGE_ME: token from @BotFather. empty = bot-less backend, which disables
# admission and the whole account flow on a live server
BOT_TOKEN=

# CHANGE_ME: numeric id of the closed community group (-1001234567890).
# empty degrades the group flow gracefully but blocks approval invitations
GROUP_CHAT_ID=
# group chat id used for kick/invite management (string form)
TELEGRAM_GROUP_CHAT_ID=

# questionnaire, json arrays. ru and en must have the same length (1..10 items)
APPLICATION_QUESTIONS_RU=["Как давно играешь в Minecraft?","Почему хочешь присоединиться?","Как часто планируешь играть?","Есть ли опыт игры на подобных серверах?"]
APPLICATION_QUESTIONS_EN=["How long have you been playing Minecraft?","Why do you want to join?","How often do you plan to play?","Do you have experience on similar servers?"]

# 3-hour voting window, the product value. no quorum inside that window means
# one automatic 3-hour extension, then the application expires
VOTING_DURATION_MINUTES=180
# how often the scheduler sweeps for expired votings
VOTING_SCAN_INTERVAL_MS=60000

# one-time group invite lifetime
GROUP_INVITE_TTL_HOURS=48

# custom emoji on vote buttons needs telegram premium on the bot owner. leave
# off until you confirmed it works for your bot (bot api 9.4)
VOTE_BUTTON_ICONS_ENABLED=false
VOTE_BUTTON_ICON_ACCEPT_ID=
VOTE_BUTTON_ICON_REJECT_ID=

# confetti on the approval celebration message (bot api 7.4)
APPROVAL_MESSAGE_EFFECT_ID=5104841245759776310

# questionnaire starts per telegram account per window
APPLICATION_START_LIMIT=3
APPLICATION_START_WINDOW_MS=60000

# trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# the only trust anchor between backend and plugin: per-game-server secrets as
# one line of json, key = the plugin's backend.server-id, value = its
# backend.secret. CHANGE_ME with `openssl rand -hex 32` for every server and
# keep the two sides byte-identical. the placeholder is exactly 32 characters
# so the boot check passes, but it is public - replace it
SERVERCORE_SERVER_CREDENTIALS={"game-1":"replace-with-openssl-rand-hex-32"}

# websocket tuning. WS_MAX_PACKET_BYTES is capped at 1 MiB by the schema
WS_HEARTBEAT_INTERVAL_MS=15000
WS_HEARTBEAT_TIMEOUT_MS=10000
WS_MAX_PACKET_BYTES=262144
# handshake timestamp window: both hosts must be within this of each other (ntp)
WS_REPLAY_WINDOW_MS=30000
WS_NONCE_TTL_MS=120000
# graceful shutdown: in-flight handlers get this long before sockets close
WS_DRAIN_TIMEOUT_MS=5000

# one-time login/link token lifetime, seconds (the schema enforces 60..90)
AUTH_REQUEST_TTL_SECONDS=75
# expiry enforcement and undelivered prompt retries
AUTH_SWEEP_INTERVAL_MS=1000

# sliding-window rate limits for the auth flow
AUTH_RATE_LIMIT_WINDOW_SECONDS=300
AUTH_RATE_LIMIT_REQUESTS_PER_PLAYER=5
AUTH_RATE_LIMIT_REQUESTS_PER_TELEGRAM=10
AUTH_RATE_LIMIT_APPROVALS_PER_TELEGRAM=30

# optional telegram message effect on the auth prompt. empty = none
AUTH_MESSAGE_EFFECT_ID=

# CHANGE_ME: comma-separated telegram user ids that get event copies and can
# call the admin-only /stats command
ADMIN_TELEGRAM_IDS=

# language of bot and ops messages: ru | en
OPS_LOCALE=ru

# no websocket frame for this long => the game server is presumed offline and
# admins get a crash alert
SERVER_OFFLINE_ALERT_MINUTES=5
# send that crash alert to every linked user as well, not only admins
NOTIFY_USERS_ON_OFFLINE=false
# outbound telegram ceiling, messages per second (telegram allows ~30/s)
NOTIFICATION_RATE_PER_SECOND=30

# custom emoji in bot messages (needs telegram premium on the bot owner)
BOT_CUSTOM_EMOJI=false

# audit/server_events lifetime and closed-session lifetime in days, then the
# first cleanup pass after boot in minutes (daily afterwards)
RETENTION_AUDIT_DAYS=90
RETENTION_SESSION_DAYS=60
RETENTION_INITIAL_DELAY_MINUTES=5

# pretty server name shown in telegram auth prompts
SERVER_NAME=ServerCore

# timezone for log timestamps and schedules. must be a valid IANA zone; the
# project standard is Europe/Moscow
LOG_TIMEZONE=Europe/Moscow
